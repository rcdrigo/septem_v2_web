<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:septem="http://septem.app/schema/1.0/bpmn"
  id="defs_teste_condicoes" targetNamespace="http://septem.app/bpmn">
  <bpmn:process id="teste_condicoes_ui" name="Teste Condicoes UI" isExecutable="true">
    <bpmn:extensionElements>
      <septem:formSchema>{&quot;type&quot;:&quot;default&quot;,&quot;schemaVersion&quot;:17,&quot;septemGroupLayout&quot;:&quot;tabs&quot;,&quot;components&quot;:[{&quot;type&quot;:&quot;group&quot;,&quot;label&quot;:&quot;Solicitante&quot;,&quot;components&quot;:[{&quot;type&quot;:&quot;textfield&quot;,&quot;key&quot;:&quot;nome&quot;,&quot;label&quot;:&quot;Nome do requisitante&quot;},{&quot;type&quot;:&quot;textfield&quot;,&quot;key&quot;:&quot;cpf&quot;,&quot;label&quot;:&quot;CPF&quot;}]},{&quot;type&quot;:&quot;group&quot;,&quot;label&quot;:&quot;Pagamento&quot;,&quot;components&quot;:[{&quot;type&quot;:&quot;number&quot;,&quot;key&quot;:&quot;valor&quot;,&quot;label&quot;:&quot;Valor da solicitação&quot;},{&quot;type&quot;:&quot;number&quot;,&quot;key&quot;:&quot;saldo_empenho&quot;,&quot;label&quot;:&quot;Saldo de empenho&quot;},{&quot;type&quot;:&quot;textarea&quot;,&quot;key&quot;:&quot;descricao&quot;,&quot;label&quot;:&quot;Descrição&quot;}]}]}</septem:formSchema>
      <septem:processConfig status="draft" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="S1" name="Preencher solicita&#231;&#227;o de pagamento">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T005" name="005. Iniciar solicita&#231;&#227;o de pagamento (Requisitante)">
      <bpmn:extensionElements>
        <septem:actionButtons>
          <septem:actionButton id="enviar" label="Enviar requisi&#231;&#227;o" primaryColor="#1e293b" textColor="#ffffff" validateForm="true" />
        </septem:actionButtons>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Tem saldo?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T006" name="006. Aprovar continuidade da Solicita&#231;&#227;o de Pagamento caso tenha Saldo de Empenho (Gestor do Contrato)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T007" name="007. Revisar solicita&#231;&#227;o">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T005" />
    <bpmn:sequenceFlow id="F2" sourceRef="T005" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" sourceRef="G1" targetRef="T006">
      <bpmn:extensionElements>
        <septem:gatewayCondition mode="rules" buttonId="enviar" buttonConnector="and">
          <septem:formRule fieldRef="" operator="eq" value="" />
          <septem:formRule fieldRef="" operator="eq" value="" connector="and" />
        </septem:gatewayCondition>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="G1" targetRef="T007">
      <bpmn:extensionElements>
        <septem:gatewayCondition mode="else" />
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="T006" targetRef="E1" />
    <bpmn:sequenceFlow id="F6" sourceRef="T007" targetRef="E1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag1">
    <bpmndi:BPMNPlane id="Plane1" bpmnElement="teste_condicoes_ui">
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T005_di" bpmnElement="T005">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T006_di" bpmnElement="T006">
        <dc:Bounds x="500" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T007_di" bpmnElement="T007">
        <dc:Bounds x="500" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1">
        <dc:Bounds x="662" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="420" y="195" />
        <di:waypoint x="420" y="140" />
        <di:waypoint x="500" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="300" />
        <di:waypoint x="500" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="600" y="140" />
        <di:waypoint x="680" y="140" />
        <di:waypoint x="680" y="202" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="600" y="300" />
        <di:waypoint x="680" y="300" />
        <di:waypoint x="680" y="238" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
